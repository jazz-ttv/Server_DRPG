P	PlayerSlow
N	Creeper
DR	COAL 10
DL	1
ML	1
AL	1
H	onTick	DRPGMob_CreeperWeak_Tick
H	onDestroy	DRPGMob_CreeperWeak_Destroy
S	$DRPG::Mobs::Creeper::Glow[0] = "0.6 1 0.7 1";
	$DRPG::Mobs::Creeper::Glow[1] = "0.373832 0.82243 0.471963 1";
	if(!isObject(sulphateExplosionProjectile))
	{
		datablock ProjectileData(sulphateExplosionProjectile : vehicleExplosionProjectile)
		{
			directDamage        = 100;
			radiusDamage        = 100;
			damageRadius        = 6;
			explosion           = vehicleExplosion;
			directDamageType  = $DamageType::Radius;
			radiusDamageType  = $DamageType::Radius;
			explodeOnDeath		= 1;
			armingDelay         = 0;
			lifetime            = 10;
		};
	}
	function DRPGMob_CreeperWeak_Tick(%creeper)
	{
		if(!isObject(%creeper) || !%creeper.ticking)
			return;
		if(isObject(%creeper.target))
			return DRPGMob_CreeperWeak_Process(%creeper,%creeper.target);
		initContainerRadiusSearch(%creeper.getTransform(),10,$TypeMasks::PlayerObjectType);
		while(isObject(%player = containerSearchNext()))
		{
			if(isObject(%player.client) && !isObject(%player.director))
			{
				if(isObject(%creeper.room) && %player.room != %creeper.room)
					continue;
				%creeper.target = %player;
				DRPGMob_CreeperWeak_Process(%creeper,%creeper.target);
				return;
			}
		}
		if(!isObject(%creeper.room))
		{
			if(!isEventPending(%creeper.destroySchedule))
				%creeper.destroySchedule = %creeper.director.schedule(2500,"fadeMob",%creeper,250);
		}
	}
	function DRPGMob_CreeperWeak_Process(%creeper,%target)
	{
		cancel(%creeper.destroySchedule);
		%dist = vectorDist(posFromTransform(%creeper.getTransform()),posFromTransform(%target.getTransform()));
		if(%dist > 25)
		{
			if(!isObject(%creeper.room))
			{
				%creeper.target = "";
				%creeper.setMoveObject("");
				%creeper.setAimObject("");
				%creeper.destroySchedule = %creeper.director.schedule(2500,"fadeMob",%creeper,250);
				return;
			}
		}
		else if(%dist <= 6)
		{
			%time = getSimTime();
			if(%creeper.ignited)
			{
				if(%time - %creeper.ignitedTime >= 2000)
				{
					cancel(%creeper.destroySchedule);
           				%p = new Projectile()
            				{
               					dataBlock = sulphateExplosionProjectile;
						initialPosition = %creeper.getTransform();
						initialVelocity = "0 0 1";
						scale = "2 2 2";
						client = %target.client;
						sourceObject = %target;
						sourceClient = %target.client;
						mobExplosion = 1;
						mobExplosionName = "Creeper";
					};
					missionCleanup.add(%p);
					initContainerRadiusSearch(%creeper.getTransform(),7.5,$TypeMasks::fxBrickObjectType);
					while(isObject(%brick = containerSearchNext()))
					{
						%db = %brick.getDatablock();
						if(%db.DRPG_isWood || %db.DRPG_isOre || %db.getVolume() > 35)
							continue;
						%brick.killBrick();
					}
					%creeper.director.destroyMob(%creeper);
					return;
				}
			}
			else
			{
				%creeper.ignited = 1;
				%creeper.ignitedTime = %time;
				%creeper.glow = 0;
			}
			%creeper.glow++;
			if(%creeper.glow > 1)
				%creeper.glow = 0;
			%creeper.setNodeColor("ALL",$DRPG::Mobs::Creeper::Glow[%creeper.glow]);
		}
		else
		{
			%creeper.ignited = 0;
			%creeper.ignitedTime = "";
			%creeper.glow = 0;
			%creeper.setNodeColor("ALL",$DRPG::Mobs::Creeper::Glow[1]);
		}
		%creeper.setMoveObject(%creeper.target);
		%creeper.setAimObject(%creeper.target);
	}
	function DRPGMob_CreeperWeak_Destroy(%creeper)
	{
		if(!isObject(%creeper))
			return;
		if(isObject(%creeper.room))
		{
			%brick = %creeper.dungeonSpawnBrick;
			if(isObject(%brick))
			{
				%time = (60000 - getRandom(2,4) * 1000 * %creeper.room.players.getCount());
				%creeper.room.generator.mobDirector.schedule(%time,"spawnMob",vectorAdd(%brick.getTransform(),"0 0 0.3"),%creeper.mobType,%creeper.room,%startTicking,1,%brick);
			}
		}
	}
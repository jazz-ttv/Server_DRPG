N	Shade of Elrad
DR	BLACK_MIST 18
DL	45
ML	45
AL	1
H	onSpawn	DRPGMob_Shade_Spawn
H	onTick	DRPGMob_Shade_Tick
H	onDestroy	DRPGMob_Shade_Destroy
S	function DRPGMob_Shade_Tick(%sw)
	{
		if(!isObject(%sw) || !%sw.ticking)
			return;
		if(isObject(%sw.target) && %sw.target.getState() !$= "Dead")
			return DRPGMob_Shade_Process(%sw,%sw.target);
		initContainerRadiusSearch(%sw.getTransform(),10,$TypeMasks::PlayerObjectType);
		while(isObject(%player = containerSearchNext()))
		{
			if(isObject(%player.client) && !isObject(%player.director) && %player.getState() !$= "Dead")
			{
				if(isObject(%sw.room) && %player.room != %sw.room)
					continue;
				%sw.target = %player;
				DRPGMob_Shade_Process(%sw,%sw.target);
				return;
			}
		}
		%sw.setImageTrigger(0,0);
		if(!isObject(%sw.room))
		{
			if(!isEventPending(%sw.destroySchedule))
				%sw.destroySchedule = %sw.director.schedule(2000,"fadeMob",%sw,1000);
		}
	}
	function DRPGMob_Shade_Process(%sw,%target)
	{
		cancel(%sw.destroySchedule);
		%dist = vectorDist(posFromTransform(%sw.getTransform()),posFromTransform(%target.getTransform()));
		if(%dist > 20)
		{
			if(!isObject(%sw.room))
			{
				%sw.target = "";
				%sw.setMoveObject("");
				%sw.setAimObject("");
				%sw.destroySchedule = %sw.director.schedule(3000,"fadeMob",%sw,1000);
				return;
			}
		}
		%sw.setMoveObject(%sw.target);
		%sw.setAimObject(%sw.target);
		if(%dist < 5)
			%sw.setImageTrigger(0,1);
		else
			%sw.setImageTrigger(0,0);
	}
	function DRPGMob_Shade_Spawn(%sw)
	{
		if(!isObject(%sw))
			return;
		%sw.playThread(2,"armReadyRight");
		%sw.mountImage(bironShortSwordImage,0);
	}
	function DRPGMob_Shade_Destroy(%sw)
	{
		if(!isObject(%sw))
			return;
		if(isObject(%sw.room))
		{
			%brick = %sw.dungeonSpawnBrick;
			if(isObject(%brick))
			{
				%time = (60000 - getRandom(2,4) * 1000 * %sw.room.players.getCount());
				%sw.room.generator.mobDirector.schedule(%time,"spawnMob",vectorAdd(%brick.getTransform(),"0 0 0.3"),%sw.mobType,%sw.room,%startTicking,1,%brick);
			}
		}
	}